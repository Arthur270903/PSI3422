#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/clock/kinetis_sim.h>
#include <nxp/kinetis/MKL25Z128VLK4-pinctrl.h>

/ {
    /* Aliases globais do projeto */
    aliases {
        pwm-trigger = &pwm_trigger;
        tpm1 = &tpm1;
        out1 = &out1;
        out2 = &out2;
        out3 = &out3;
        out4 = &out4;
    };


    pins_control {
        compatible = "gpio-keys ";

        out1: pin_out_1 {
            gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
                status = "okay";
        
        };
        out2: pin_out_2 {
            gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
            
        };
        out3: pin_out_3 {
            gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
            
        };
        out4: pin_out_4 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
                status = "okay";
            
        };

        
    };

    /* Dispositivo PWM Customizado */
    pwmtriggers {
        compatible = "simple-bus";

        pwm_trigger: pwm_trigger {
            compatible = "my,pwm-trigger";
            pwms = <&tpm0 0 PWM_MSEC(60) PWM_POLARITY_NORMAL>;
        };
    };
};

/* Habilita as portas GPIO que estão sendo utilizadas */
&gpioa { status = "okay"; };
&gpioc { status = "okay"; };
&gpioe { status = "okay"; };

/* Configuração de Pinctrl */
&pinctrl {
    tpm0_default: tpm0_default {
        group0 {
            pinmux = <TPM0_CH0_PTD0>;
            drive-strength = "low";
            slew-rate = "slow";
        };
    };

    tpm1_default: tpm1_default {
        group0 {
            pinmux = <TPM1_CH0_PTE20>;
            drive-strength = "low";
            slew-rate = "slow";
        };
    };
};

/* Configuração dos periféricos TPM (PWM) estendidos */
&tpm0 {
    compatible = "nxp,kinetis-tpm";
    reg = <0x40038000 0x1000>;
    interrupts = <17 0>;
    prescaler = <64>;
    clocks = <&sim KINETIS_SIM_BUS_CLK 0x103C 24>;
    pinctrl-0 = <&tpm0_default>;
    pinctrl-names = "default";
    #pwm-cells = <3>;
    status = "okay";
};

&tpm1 {
    compatible = "nxp,kinetis-tpm";
    reg = <0x40039000 0x1000>;
    interrupts = <18 1>;
    prescaler = <8>;
    clocks = <&sim KINETIS_SIM_BUS_CLK 0x103C 25>;
    pinctrl-0 = <&tpm1_default>;
    pinctrl-names = "default";
    #pwm-cells = <3>;
    status = "okay";
};
/*Portas da ponte H */
/* Ativa explicitamente o controlador do PORTC */
&gpioc {
    status = "okay";
};

/ {
    aliases {
        in1 = &in1_node;
        in2 = &in2_node;
        in3 = &in3_node;
        in4 = &in4_node;
    };

    ponte_h_pins {
        compatible = "gpio-leds";
        
        in1_node: in1 {
            gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>; /* PTC3 (Pino D0 da placa) */
        };
        in2_node: in2 {
            gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>; /* PTC4 (Pino D1 da placa) */
        };
        in3_node: in3 {
            gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>; /* PTC5 (Pino D2 da placa) */
        };
        in4_node: in4 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>; /* PTC6 (Pino D3 da placa) */
        };
    };
};